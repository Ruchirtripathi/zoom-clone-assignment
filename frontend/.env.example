# Frontend Environment Variables

# The base URL of the FastAPI backend REST endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000

# The base URL of the FastAPI WebSocket server (use wss:// for production)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Optional: Custom ICE servers for WebRTC (JSON array string). Leave blank to use default Google STUN.
# NEXT_PUBLIC_ICE_SERVERS=[{"urls": "stun:stun.l.google.com:19302"}]
