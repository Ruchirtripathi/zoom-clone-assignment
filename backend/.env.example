# Backend Environment Variables

# Comma-separated list of allowed CORS origins. MUST include the production frontend URL.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Path to the SQLite database. If omitted, defaults to zoom.db in the backend directory.
# Useful for storing the database on a persistent volume in production (e.g. Render Disk or Railway Volume).
# DATABASE_PATH=/data/zoom.db